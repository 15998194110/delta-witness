{
  "name": "delta-witness-base-app",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "check": "tsc --noEmit -p tsconfig.app.json --pretty false",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build",
    "deploy": "wrangler pages deploy dist --project-name delta-witness-app"
  },
  "dependencies": {
    "@x402/core": "^2.24.0",
    "@x402/evm": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "latest",
    "vite": "^7.1.3",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
