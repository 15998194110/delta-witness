{
  "name": "delta-witness-partner-gateway",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "verify": "node ../../scripts/check-owner-pricing.mjs && npm run types && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
