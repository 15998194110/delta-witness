{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "delta-witness-partner-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "delta-witness-proofs"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://delta-witness-api.ruphussten.workers.dev"
  }
}
