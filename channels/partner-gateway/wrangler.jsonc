{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "delta-witness-partner-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "services": [
    {
      "binding": "CORE",
      "service": "delta-witness-api"
    }
  ],
  "ratelimits": [
    {
      "name": "PARTNER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    "APP_VERSION": "0.6.1",
    "PARTNER_ID": "marketplace",
    "PARTNER_NET_CAPTURE_USD": "0.03",
    "PARTNER_NET_PREFLIGHT_USD": "0.03",
    "PARTNER_NET_WATCH_CHECK_USD": "0.03"
  }
}
