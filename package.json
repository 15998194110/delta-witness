{
  "name": "delta-witness",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "funnel": "node scripts/query-funnel.mjs",
    "bazaar": "node scripts/check-bazaar.mjs",
    "pricing-authority": "node scripts/check-owner-pricing-authority.mjs",
    "verify": "node scripts/check-owner-pricing.mjs && npm run pricing-authority && npm run types && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/extensions": "2.29.0",
    "@x402/hono": "2.29.0",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
