{
  "name": "delta-witness-mcp",
  "version": "0.6.0",
  "description": "MCP tools for paid DELTA Witness Capture and Guard preflight observations",
  "type": "module",
  "bin": { "delta-witness-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "exports": "./dist/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
